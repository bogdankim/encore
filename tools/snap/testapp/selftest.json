  {"drag": {"from": [5, 30], "to": [9, 32]}},
  {"assert": "motion x=7 y=31 button=left"},
  {"assert": "release x=9 y=32 button=left"},
  {"move": [100, 40]},
  {"assert": "mouse: motion x=100 y=40 button=none"},
  {"keys": ["i"]},
  {"shot": "selftest-events"},
  {"shot": "selftest-zoom", "region": [0, 0, 95, 14], "scale": 3},
  {"resize": [100, 30]},
  {"assert": "size=100x30"},
  {"assertNot": "size=140x42"},
  {"shot": "selftest-resized"},
  {"keys": ["q"]},
  {"expectExit": 3000, "code": 0}
